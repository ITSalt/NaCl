const {chromium}=require('/Users/maxnikitin/.nvm/versions/node/v24.13.1/lib/node_modules/@playwright/test/node_modules/playwright');
(async()=>{const port=process.env.PILOT_PORT;if(!/^\d+$/.test(port||''))throw Error('PILOT_PORT required');const origin='http://127.0.0.1:'+port;const browser=await chromium.launch({headless:true});const results=[];
const photos=[{id:'p1',sessionId:'session-test',position:1,originalUrl:'/fixture/original.svg',enhancedUrl:'/fixture/enhanced.svg',processingStatus:'enhanced',createdAt:'2026-01-01T00:00:00.000Z'},{id:'p2',sessionId:'session-test',position:2,originalUrl:'/fixture/processing.svg',enhancedUrl:null,processingStatus:'enhancing',createdAt:'2026-01-01T00:00:00.000Z'}];
for(const kind of ['open','close','escape','toggle','enhancing']) {const ctx=await browser.newContext({viewport:{width:800,height:600},serviceWorkers:'block'}), unexpected=[];await ctx.addInitScript(()=>localStorage.setItem('fc_session_store',JSON.stringify({state:{activeSessionId:'session-test',deviceFingerprint:null},version:0})));
await ctx.route('**/*',async r=>{const q=r.request(),u=new URL(q.url()),p=u.pathname;if(u.origin!==origin){unexpected.push('origin '+u.origin);return r.abort()}if(p.startsWith('/api/')){if(q.method()==='GET'&&p==='/api/sessions/session-test')return r.fulfill({json:{data:{id:'session-test',status:'interview'}}});if(q.method()==='GET'&&p==='/api/memories/photos')return r.fulfill({json:{data:photos}});if(q.method()==='GET'&&p==='/api/memories/photos/p2/status')return r.fulfill({json:{data:{id:'p2',processingStatus:'enhancing',enhancedUrl:null,errorMessage:null}}});unexpected.push(q.method()+' '+p);return r.abort()}if(p.startsWith('/fixture/'))return r.fulfill({contentType:'image/svg+xml',body:'<svg xmlns="http://www.w3.org/2000/svg" width="60" height="60"><rect width="60" height="60" fill="'+(p.includes('enhanced')?'blue':'red')+'"/></svg>'});return r.continue()});
let phase='setup';const page=await ctx.newPage();page.on('pageerror',e=>unexpected.push('pageerror '+e.message));try{const response=await page.goto(origin+'/memories/upload',{waitUntil:'domcontentloaded',timeout:30000});if(response.status()!==200)throw Error('INVALID_HARNESS_HTTP');await page.getByRole('heading',{name:'Загрузите фотографии'}).waitFor({timeout:10000});const card=page.getByRole('img',{name:kind==='enhancing'?'Фото 2':'Фото 1'});await card.waitFor({timeout:10000});if(await page.getByRole('dialog').count())throw Error('INVALID_HARNESS_DIALOG_PREEXISTS');phase='assertion';if(process.env.PILOT_INJECT_BAD==='1')await page.evaluate(()=>fetch('https://foreign.example/api/sessions/session-test').catch(()=>null));await card.click();const dialog=page.getByRole('dialog');if(kind==='enhancing'){await page.waitForTimeout(500);if(await dialog.count())throw Error('UNEXPECTED_DIALOG');}else{await dialog.waitFor({state:'visible',timeout:1200});if(kind==='open'){const image=dialog.getByRole('img');if(await image.count()!==1||await image.getAttribute('src')!=='/fixture/enhanced.svg')throw Error('IMAGE_MISMATCH');}if(kind==='close'){await dialog.getByRole('button',{name:'Закрыть',exact:true}).click();if(await dialog.count())throw Error('DIALOG_NOT_CLOSED');}if(kind==='escape'){await page.keyboard.press('Escape');if(await dialog.count())throw Error('DIALOG_NOT_CLOSED');}if(kind==='toggle'){const image=dialog.getByRole('img');await dialog.getByRole('button',{name:'Оригинал',exact:true}).click();if(await image.getAttribute('src')!=='/fixture/original.svg')throw Error('ORIGINAL_MISMATCH');await dialog.getByRole('button',{name:'Улучшено',exact:true}).click();if(await image.getAttribute('src')!=='/fixture/enhanced.svg')throw Error('ENHANCED_MISMATCH');}}if(unexpected.length)throw Error('INVALID_HARNESS_UNEXPECTED_REQUEST');results.push({case:kind,status:'PASS'});}catch(e){results.push({case:kind,status:phase==='setup'||unexpected.length>0||e.message.includes('INVALID_HARNESS')?'INVALID_HARNESS':'FAIL',reason:e.message.split('\n')[0],unexpected});}finally{await ctx.close()}}
console.log(JSON.stringify(results));await browser.close();if(results.some(x=>x.status!=='PASS'))process.exitCode=1;
})().catch(e=>{console.error('runner error:',e.message);process.exitCode=2});
